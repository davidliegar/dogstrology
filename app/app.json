{
  "expo": {
    "name": "Dogstrology",
    "slug": "dogstrology",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/production/icon.png",
    "scheme": "dogstrology",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nexus.zoodiac",
      "supportsTablet": true
    },
    "android": {
      "package": "com.nexus.zoodiac",
      "adaptiveIcon": {
        "backgroundColor": "#0E142B",
        "foregroundImage": "./assets/icons/production/android-icon-foreground.png",
        "backgroundImage": "./assets/icons/production/android-icon-background.png",
        "monochromeImage": "./assets/icons/production/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icons/production/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#E8C87A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1026",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dogstrology usa tus fotos solo para el retrato de tu mascota. La copia se queda en el móvil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "contentBaseUrl": "https://dogstrology.davidliegar.workers.dev/daily/",
      "router": {},
      "eas": {
        "projectId": "0a43767b-8ca7-481f-af35-661652f8f79f"
      },
      "revenueCatApiKey": "goog_eRaxcjDruTUzVMJzeMJRWdoWsVY",
      "revenueCatTestApiKey": "test_DvxmFRwqcGSOiwYxbtRJuoNraES",
      "posthogApiKey": "phc_sTpKhmUMm7CNRVTzLVqZ5qeCF59Yfhcm3Nwbp6anyBNa"
    },
    "owner": "davidliegars-team"
  }
}
