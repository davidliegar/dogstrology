{
  "expo": {
    "name": "Dogstrology",
    "slug": "dogstrology",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dogstrology",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nexus.zoodiac",
      "supportsTablet": true
    },
    "android": {
      "package": "com.nexus.zoodiac",
      "adaptiveIcon": {
        "backgroundColor": "#0B1026",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a43767b-8ca7-481f-af35-661652f8f79f"
      }
    },
    "owner": "davidliegars-team"
  }
}
