{
  "cli": {
    "version": ">=22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "internal": {
      "extends": "production",
      "env": {
        "ALLOW_PROVISIONAL_CONTENT_URL": "internal"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
